<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- User group - read-only access -->
        <record id="group_kprl_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <!-- <field name="description">Read-only access to dashboard and employee self-service</field> -->
        </record>

        <!-- HR group -->
        <record id="group_kprl_hr" model="res.groups">
            <field name="name">HR Manager</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_kprl_user'))]"/>
            <!-- <field name="description">Can edit performance inputs, view payouts, manage employees</field> -->
        </record>

        <!-- Finance group -->
        <record id="group_kprl_finance" model="res.groups">
            <field name="name">Finance Manager</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_kprl_hr'))]"/>
            <!-- <field name="description">Can edit parameters (within limits), run computation, manage deferred</field> -->
        </record>

        <!-- CEO/Superadmin group - full access -->
        <record id="group_kprl_ceo" model="res.groups">
            <field name="name">CEO / Superadmin</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_kprl_finance'))]"/>
            <!-- <field name="description">Full access: approve parameter changes, governance events, all operations</field> -->
        </record>
    </data>
</odoo>
