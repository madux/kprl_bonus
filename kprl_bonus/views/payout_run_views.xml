<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Compensation run surface (parallel screen). Existing payout views untouched. -->
    <record id="action_kprl_payout_run" model="ir.actions.act_window">
        <field name="name">Compensation Runs</field>
        <field name="res_model">kprl.payout.run</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_kprl_payout_run_tree" model="ir.ui.view">
        <field name="name">kprl.payout.run.tree</field>
        <field name="model">kprl.payout.run</field>
        <field name="arch" type="xml">
            <tree>
                <field name="period_id"/>
                <field name="revision_no"/>
                <field name="state" widget="badge"/>
                <field name="employee_count"/>
                <field name="calculated_count"/>
                <field name="blocked_count"/>
                <field name="total_net_payable"/>
                <field name="calculated_at"/>
            </tree>
        </field>
    </record>

    <record id="view_kprl_payout_run_form" model="ir.ui.view">
        <field name="name">kprl.payout.run.form</field>
        <field name="model">kprl.payout.run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_calculate" type="object" string="Calculate"
                            class="btn-primary" invisible="state not in ('draft', 'calculating', 'review')"/>
                    <button name="action_submit" type="object" string="Submit for Approval"
                            class="btn-primary" invisible="state != 'review'"/>
                    <button name="action_approve" type="object" string="Approve (CEO)"
                            class="btn-success" invisible="state != 'ready'"/>
                    <button name="action_lock" type="object" string="Lock"
                            invisible="state != 'approved'"/>
                    <button name="action_export" type="object" string="Export Excel"
                            invisible="state not in ('review', 'ready', 'approved', 'locked')"/>
                    <button name="action_create_revision" type="object" string="Create Revision"
                            invisible="state not in ('approved', 'locked')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,calculating,review,ready,approved,locked"/>
                </header>
                <sheet>
                    <group string="Run">
                        <group>
                            <field name="period_id"/>
                            <field name="revision_no" readonly="1"/>
                            <field name="revision_of" readonly="1"/>
                            <field name="superseded_by" readonly="1"/>
                        </group>
                        <group string="Policy Snapshot">
                            <field name="policy_source_id" readonly="1"/>
                            <field name="policy_version" readonly="1"/>
                            <field name="calculated_at" readonly="1"/>
                            <field name="approved_by" readonly="1"/>
                            <field name="approved_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Totals">
                        <group>
                            <field name="employee_count" readonly="1"/>
                            <field name="calculated_count" readonly="1"/>
                            <field name="blocked_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="combined_gross" readonly="1"/>
                            <field name="proration" readonly="1"/>
                            <field name="cap_pressure" readonly="1"/>
                            <field name="total_net_payable" readonly="1"/>
                            <field name="total_deferred" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids" readonly="state in ('approved', 'locked', 'ready')">
                                <tree editable="bottom">
                                    <field name="employee_id"/>
                                    <field name="source" readonly="1"/>
                                    <field name="status" widget="badge"/>
                                    <field name="engines"/>
                                    <field name="sub_pool"/>
                                    <field name="ops_gross"/>
                                    <field name="sales_gross"/>
                                    <field name="net_payable"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_kprl_payout_run_line_form" model="ir.ui.view">
        <field name="name">kprl.payout.run.line.form</field>
        <field name="model">kprl.payout.run.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Employee">
                        <group>
                            <field name="employee_id" readonly="parent.state not in ('draft', 'calculating', 'review')"/>
                            <field name="source" readonly="1"/>
                            <field name="run_id" readonly="1"/>
                            <field name="status" readonly="1"/>
                        </group>
                        <group string="Classification">
                            <field name="engines" readonly="1"/>
                            <field name="sub_pool" readonly="1"/>
                        </group>
                    </group>
                    <group string="Payment Summary">
                        <group>
                            <field name="ops_gross" readonly="1"/>
                            <field name="sales_gross" readonly="1"/>
                            <field name="combined_gross" readonly="1"/>
                        </group>
                        <group>
                            <field name="proration" readonly="1"/>
                            <field name="cap_adjustment" readonly="1"/>
                            <field name="net_payable" readonly="1"/>
                            <field name="deferred" readonly="1"/>
                        </group>
                    </group>
                    <group string="Review">
                        <field name="blocking_errors_text" readonly="1"/>
                        <field name="warnings_text" readonly="1"/>
                    </group>
                    <group string="Calculation Breakdown (frozen snapshot)">
                        <field name="snapshot_html" nolabel="1" readonly="1"/>
                        <field name="preview_json" readonly="1" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
