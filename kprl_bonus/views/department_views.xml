<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kprl_department_tree" model="ir.ui.view">
        <field name="name">kprl.department.tree</field>
        <field name="model">kprl.department</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="manager_id"/>
                <field name="kpi_multiplier"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>

    <record id="view_kprl_department_form" model="ir.ui.view">
        <field name="name">kprl.department.form</field>
        <field name="model">kprl.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="manager_id"/>
                            <field name="kpi_multiplier"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kprl_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">kprl.department</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
