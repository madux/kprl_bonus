<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kprl_subpool_tree" model="ir.ui.view">
        <field name="name">kprl.subpool.tree</field>
        <field name="model">kprl.subpool</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="pool_share_pct"/>
                <field name="min_share_pct"/>
                <field name="max_share_pct"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>

    <record id="view_kprl_subpool_form" model="ir.ui.view">
        <field name="name">kprl.subpool.form</field>
        <field name="model">kprl.subpool</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="pool_share_pct"/>
                            <field name="min_share_pct"/>
                            <field name="max_share_pct"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kprl_subpool" model="ir.actions.act_window">
        <field name="name">Sub-Pools</field>
        <field name="res_model">kprl.subpool</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
