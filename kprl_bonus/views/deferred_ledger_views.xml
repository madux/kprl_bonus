<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_kprl_deferred_ledger" model="ir.actions.act_window">
        <field name="name">Deferred Bonus Ledger</field>
        <field name="res_model">kprl.deferred.ledger</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <record id="view_kprl_deferred_ledger_tree" model="ir.ui.view">
        <field name="name">kprl.deferred.ledger.tree</field>
        <field name="model">kprl.deferred.ledger</field>
        <field name="arch" type="xml">
            <tree>
                <field name="employee_id"/>
                <field name="period_id"/>
                <field name="grade_id"/>
                <field name="calculated_bonus" widget="monetary"/>
                <field name="deferral_rate"/>
                <field name="deferred_amount" widget="monetary"/>
                <field name="vest_date"/>
                <field name="status" widget="badge"/>
                <field name="clawback_event_id"/>
            </tree>
        </field>
    </record>

    <record id="view_kprl_deferred_ledger_form" model="ir.ui.view">
        <field name="name">kprl.deferred.ledger.form</field>
        <field name="model">kprl.deferred.ledger</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_vest" type="object"
                            string="Mark Vested"
                            class="btn-success"
                            invisible="status != 'deferred'"/>
                    <button name="action_forfeit" type="object"
                            string="Forfeit"
                            class="btn-danger"
                            invisible="status != 'deferred'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="period_id"/>
                            <field name="status"/>
                            <field name="grade_id"/>
                            <field name="is_senior_mgmt"/>
                        </group>
                        <group>
                            <field name="calculated_bonus" widget="monetary"/>
                            <field name="deferral_rate"/>
                            <field name="deferred_amount" widget="monetary"/>
                            <field name="vest_date"/>
                            <field name="status"/>
                            <field name="clawback_event_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    
</odoo>