<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record id="action_kprl_bonus_payout" model="ir.actions.act_window">
        <field name="name">Staff Payouts</field>
        <field name="res_model">kprl.bonus.payout</field>
        <field name="view_mode">tree,form,search</field>
    </record>
    <record id="view_kprl_bonus_payout_tree" model="ir.ui.view">
        <field name="name">kprl.bonus.payout.tree</field>
        <field name="model">kprl.bonus.payout</field>
        <field name="arch" type="xml">
            <tree>
                <field name="period_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="grade_id"/>
                <field name="gross_payable" widget="monetary"/>
                <field name="deferred_amount" widget="monetary"/>
                <field name="net_immediate" widget="monetary"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_kprl_bonus_payout_form" model="ir.ui.view">
        <field name="name">kprl.bonus.payout.form</field>
        <field name="model">kprl.bonus.payout</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object"
                            string="Approve"
                            class="btn-success"
                            invisible="state != 'computed'"/>
                    <button name="action_paid" type="object"
                            string="Mark Paid"
                            class="btn-primary"
                            invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="period_id"/>
                            <field name="department_id"/>
                            <field name="grade_id"/>
                            <field name="subpool_id"/>
                        </group>
                        <group string="Calculated Amounts">
                            <field name="gross_payable" widget="monetary"/>
                            <field name="deferred_amount" widget="monetary" readonly="0" force_save="1"/>
                            <field name="net_immediate" widget="monetary" readonly="0" force_save="1"/>
                        </group>
                    </group>
                    <group string="Multipliers &amp; Adjustments">
                        <group>
                            <field name="base_eligible" widget="monetary" readonly="1"/>
                            <field name="dept_kpi_mult"/>
                            <field name="appraisal_mult"/>
                            <field name="behavioural_mult"/>
                            <field name="behaviour_05"/>
                            <field name="adjusted_amount" readonly="1" widget="monetary"/>
                            <field name="tenure_years"/>

                        </group>
                        <group>
                            <field name="tenure_mult"/>
                            <field name="proration_factor"/>
                            <field name="gmp_factor"/>
                            <field name="deferral_rate" readonly="0" widget="monetary"/>
                            <field name="value_point"/>
                            <field name="total_points" readonly="0" force_save="1"/>
                            <field name="payable"/>
                        </group>
                        <group>
                            <field name="exception_premium" widget="monetary"/>
                            <field name="tenure_enhance"/>
                            <field name="quarterly_amount" string="★ QUATERTLY PAYOUT (₦)"/>
                            <field name="final_floor" readonly="1" force_save="1"/>
                        </group>
                        <group>
                            <field name="malus_amount" widget="monetary"/>
                            <field name="floor_check"/>
                            <field name="cap_check"/> 

                        </group>
                    </group>
                    <group>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_kprl_bonus_payout_search" model="ir.ui.view">
        <field name="name">kprl.bonus.payout.search</field>
        <field name="model">kprl.bonus.payout</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="period_id"/>
                <field name="department_id"/>
                <field name="state"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
            </search>
        </field>
    </record>

   
</odoo>
